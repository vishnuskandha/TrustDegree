# Backend production environment (Render)
NODE_ENV=production
PORT=3000

# Comma-separated CORS origins
ALLOWED_ORIGINS=https://trustdegree.vercel.app,https://www.trustdegree.vercel.app

# Production DB URL (Supabase or Neon)
DATABASE_URL=postgresql://postgres:replace-password@db.replace-host.supabase.co:5432/postgres?sslmode=require

# Required for this codebase in production/staging
# Put the full PEM content with escaped newlines: -----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
PG_SSL_CA=-----BEGIN CERTIFICATE-----\nREPLACE_WITH_PROVIDER_CA_PEM\n-----END CERTIFICATE-----

# JWT
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=7d

# Smart contract and blockchain
CONTRACT_ADDRESS=0xReplaceWithYourContractAddress
PRIVATE_KEY=0xReplaceWithAdminWalletPrivateKey
POLYGON_MUMBAI_RPC=https://polygon-mumbai.g.alchemy.com/v2/replace-with-key

# Optional explicit schema path
SCHEMA_SQL_PATH=/app/sql/schema.sql

# API base used for verification URL generation
API_URL=https://trustdegree-api.onrender.com

# Rate limiter (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
READY_RATE_LIMIT_WINDOW_MS=60000
READY_RATE_LIMIT_MAX_REQUESTS=60
